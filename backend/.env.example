# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Admin login (demo credentials — now also used as fallback if platform_settings not seeded)
ADMIN_EMAIL=admin@bolkhata.in
ADMIN_PASSWORD=admin123

# Dev OTP — always accepted in dev mode instead of sending a real SMS
DEV_OTP=1234

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Database — SQLite for local dev, Postgres for production (Render/Railway)
# Local: sqlite:///./bolkhata.db
# Prod example: postgresql+psycopg2://user:pass@host:5432/bolkhata
DATABASE_URL=sqlite:///./bolkhata.db

# ---- Real integrations (optional — leave blank to keep mock behaviour) ----
# Instead of .env, prefer Admin → Settings → API Connections to configure and test in-app
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
